# Envoi hebdomadaire « ON A LU POUR VOUS » via Resend (aucune valeur secrète ici).
# Obligatoires
RESEND_API_KEY=
RESEND_SEGMENT_ID=
RESEND_TEMPLATE_ID=
# Adresses du compte rendu, séparées par des virgules
REVUE_ALERTES=
# off (rien) | brouillon (campagne créée, non programmée) | programmer
REVUE_RESEND_MODE=off
# Secret de Vercel Cron (protège /api/cron/revue-hebdo)
CRON_SECRET=
# Numéro du premier volume, si aucune campagne « ON A LU POUR VOUS VOL. » n'existe encore
REVUE_VOLUME_DEPART=33

# Facultatives : remplacent l'expéditeur et la réponse du modèle
# (l'objet est toujours « ON A LU POUR VOUS VOL. <numéro> »)
REVUE_FROM=
REVUE_REPLY_TO=
# Expéditeur du compte rendu (par défaut REVUE_FROM, sinon celui du modèle)
REVUE_ALERTES_FROM=

# Authentification de l'espace administrateur (NextAuth / Auth.js v5)
# NEXTAUTH_URL doit correspondre au domaine réellement servi (sinon les
# redirections de connexion pointent vers le mauvais site).
NEXTAUTH_URL=
NEXTAUTH_SECRET=
