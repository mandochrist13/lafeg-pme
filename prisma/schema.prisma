generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TexteJuridique {
  id_texteJuridique String   @id @default(uuid())
  titre             String
  type_texte        String
  fichier_url       String
  fichier_nom       String
  taille_fichier    Int?
  mime_type         String   @default("application/pdf")
  categorie         String
  description       String?
  date_parution     DateTime
  version           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("texte_juridique")
}

model Offre {
  id_offre      String      @id @default(uuid())
  titre_offre   String
  nom_structure String
  type_offre    String
  membre_feg    Boolean
  contact       String
  image_nom     String?
  image_url     String?
  bannier_nom   String?
  bannier_url   String?
  description   String?
  email         String
  localisation  String
  site_web      String
  fichier_url   String
  fichier_nom   String
  date_debut    DateTime
  date_fin      DateTime
  statut        StatutOffre @default(INACTIF)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("offre")
}

model Vente {
  id_vente      String   @id @default(uuid())
  libelle       String
  image_url     String
  image_nom     String
  taille_image  Int?
  mime_type     String
  nom_structure String
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lien          String?

  @@map("vente")
}

model Actualite {
  id         String   @id @default(uuid())
  titre      String
  contenu    String
  imageUrl   String?
  datePub    DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  categorie  String?
  source     String?
  lienSource String?

  @@map("actualite")
}

model Institutions {
  id_institution   String   @id @default(uuid())
  nom              String
  categorie        String
  type_institution String
  partenaire_feg   Boolean?
  description      String?
  image_url        String?
  image_nom        String?
  taille_image     Int?
  image_mime_type  String?  @default("image/jpeg")
  adresse          String?
  contact          String?
  mail             String?
  site_web         String?
  rs_1             String?
  rs_2             String?
  service          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("institution_financiere")
}

model SEA {
  id_sea         String   @id @default(uuid())
  nom            String
  description    String?
  type_sea       String
  categorie      String
  services       String[]
  adresse        String?
  contact        String?
  mail           String?
  site_web       String?
  rs_1           String?
  rs_2           String?
  logo_url       String?
  logo_nom       String?
  taille_logo    Int?
  logo_mime_type String?  @default("image/jpeg")
  partenaire_feg Boolean?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("sea")
}

model Utilisateur {
  id_utilisateur     String    @id @default(uuid())
  nom                String
  prenom             String
  email              String    @unique
  mot_de_passe       String
  role               Role      @default(ADMIN)
  date_creation      DateTime  @default(now())
  derniere_connexion DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("utilisateur")
}

enum Role {
  ADMIN
  MODERATEUR
  EDITEUR
  UTILISATEUR
}

enum StatutOffre {
  ACTIF
  INACTIF
  ARCHIVE
}
